results/**/trades.csv
results/**/equity_out_of_sample.csv

# Large, and the golden trades and metrics already cover it
tests/golden/**/equity_out_of_sample.csv

# Phase 6 universe prices from Tiingo, also not redistributable
data/dow30/

# Phase 7 fresh test data (2025 onward), also from Tiingo
data/fresh/

# libFuzzer's output. A local corpus can hold fragments of any data it was seeded with,
# including the Tiingo prices above.
/corpus/
/crash-*
/leak-*
/oom-*
/timeout-*
